<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!--
      Tepsi ikonu için WinForms'un NotifyIcon'ı kullanılıyor: sıfır bağımlılık,
      Microsoft bakımında ve TaskbarCreated olayını (Explorer çökerse ikon
      kaybolması) kendisi hallediyor.

      ⚠️ Bedeli isim çakışması: MenuItem, ContextMenu, Application, Brushes
      hem WPF'te hem WinForms'ta var. Bu yüzden TrayIcon.cs takma ad kullanıyor.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>tokenbar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ⚠️ ApplicationIcon yukarıda EXE'nin ikonunu ayarlıyor — ama XAML'deki
      Icon="tokenbar.ico" onu görmüyor. Pencere ikonu için dosyanın ayrıca
      Resource olarak gömülmesi gerekiyor. İkisi ayrı mekanizma.
    -->
    <None Remove="tokenbar.ico" />
    <Resource Include="tokenbar.ico" />
    <ProjectReference Include="..\src\TokenBar.Core\TokenBar.Core.csproj" />
  </ItemGroup>

</Project>
