<Window x:Class="tokenbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenBar"
        Height="760" Width="470"
        MinHeight="440" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#FF15171C"
        Icon="tokenbar.ico">

    <!--
      Bu dosya SADECE görünüm. Hiç mantık yok.
      Kod tarafı MainWindow.xaml.cs — ikisi "partial class" ile aynı sınıf.
    -->

    <Window.Resources>

        <Style x:Key="Etiket" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A90A0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AltEtiket" TargetType="TextBlock" BasedOn="{StaticResource Etiket}">
            <Setter Property="Foreground" Value="#FF616978"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Tabular = rakamlar eşit genişlikte, alt alta hizalanır. -->
        <Style x:Key="Sayi" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="AltSayi" TargetType="TextBlock" BasedOn="{StaticResource Sayi}">
            <Setter Property="Foreground" Value="#FF616978"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DuzButon" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="Background" Value="#FF2A2F3B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Kutu"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Kutu" Property="Background" Value="#FF3B4252"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaglantiButon" TargetType="Button" BasedOn="{StaticResource DuzButon}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF7A8296"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Kota çubuğu. ProgressBar PART_Indicator'ın genişliğini kendi ayarlar. -->
        <Style x:Key="KotaCubugu" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#FF2A2F3B" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="#FF7EE0C0"
                                           RadiusX="3" RadiusY="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Örtük stil: x:Key yok, penceredeki TÜM ScrollBar'lara uygulanır.
          WPF'in hazır kaydırma çubuğu açık temalı, koyu zeminde sırıtıyordu.
        -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF3A4150" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─────────── Ajan kartı ─────────── -->
        <DataTemplate x:Key="AjanKartiSablonu">
            <Border Background="#FF1D2027" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                <StackPanel>

                    <!-- Ad + toplam -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Ad}"
                                   Foreground="#FFE8EAF0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Toplam}"
                                   Foreground="#FF7EE0C0"
                                   FontSize="22"
                                   FontWeight="Light"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <Border Height="1" Background="#FF262B34" Margin="0,11,0,10"/>

                    <!-- Kırılım -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="yeni girdi" Style="{StaticResource Etiket}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding YeniGirdi}" Style="{StaticResource Sayi}"/>

                        <TextBlock Grid.Row="1" Text="önbellekten" Style="{StaticResource AltEtiket}" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Onbellek}" Style="{StaticResource AltSayi}" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OnbellekYuzde}"
                                   Style="{StaticResource AltSayi}" Margin="10,4,0,4" MinWidth="42"/>

                        <TextBlock Grid.Row="2" Text="çıktı" Style="{StaticResource Etiket}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Cikti}" Style="{StaticResource Sayi}"/>
                    </Grid>

                    <!-- Alt ajan satırı — yoksa hiç görünmez -->
                    <TextBlock Text="{Binding AltAjan}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AltEtiket}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AltAjan}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Kota — sağlayıcı vermiyorsa hiç görünmez -->
                    <StackPanel Margin="0,13,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KotaVar}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding KotaBaslik}" Style="{StaticResource Etiket}" Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding KotaOran, Mode=OneWay}" Style="{StaticResource KotaCubugu}"/>
                        <TextBlock Text="{Binding KotaAlt}" Style="{StaticResource AltEtiket}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Uyarı — sağlayıcı bir şey söylediyse -->
                    <TextBlock Text="{Binding UyariMetni}" Foreground="#FFE0B36A" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Uyari}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Istatistik}" Style="{StaticResource AltEtiket}"
                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 başlık -->
            <RowDefinition Height="*"/>      <!-- 1 içerik -->
            <RowDefinition Height="Auto"/>   <!-- 2 durum -->
        </Grid.RowDefinitions>

        <!-- ── 0 ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    x:Name="YenileButton"
                    Content="Yenile"
                    Style="{StaticResource DuzButon}"
                    Click="YenileButton_Click"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TokenBar"
                           Foreground="#FFE8EAF0"
                           FontSize="19"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="AltBaslikText"
                           Text="okunuyor…"
                           Style="{StaticResource AltEtiket}"
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ── 1 ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Genel toplam: varsayılan KAPALI, çünkü ajanlar arası
                     token karşılaştırması yanıltıcı. -->
                <Border x:Name="GenelToplamKutu"
                        Background="#FF1A1D24"
                        BorderBrush="#FF262B34"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,12"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="genel toplam" Style="{StaticResource Etiket}"/>
                            <TextBlock Grid.Column="1" x:Name="GenelToplamText" Text="—"
                                       Style="{StaticResource Sayi}" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="⚠️ Karşılaştırma amaçlı değildir — her ajanın tokenizer'ı ve fiyatı farklı."
                                   Style="{StaticResource AltEtiket}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="KartListesi" ItemTemplate="{StaticResource AjanKartiSablonu}"/>

                <!-- Okunmayan ajanlar -->
                <ItemsControl x:Name="PasifListesi" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Ad}" Style="{StaticResource AltEtiket}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Sebep}" Style="{StaticResource AltEtiket}"
                                           FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="OTURUMLAR · en çok harcayandan"
                           Style="{StaticResource Etiket}" FontSize="11" Margin="2,16,0,8"/>

                <Border Background="#FF1D2027" CornerRadius="10" Padding="4,6">
                    <ItemsControl x:Name="OturumListesi">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FF262B34" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Ajan}" Foreground="#FF8A90A0" FontSize="10"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Etiket}"
                                               Foreground="#FF9BA2B2" FontSize="12"
                                               Margin="9,0,8,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Toplam}"
                                               Foreground="#FFE8EAF0" FontSize="13"
                                               VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 2 ── -->
        <StackPanel Grid.Row="2" Margin="2,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="GenelToplamButton"
                        Content="genel toplamı göster"
                        Style="{StaticResource BaglantiButon}"
                        Click="GenelToplamButton_Click"/>
                <TextBlock x:Name="DurumText" Text="" Style="{StaticResource Etiket}"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="HataText" Text="" Foreground="#FFE86A6A" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

    </Grid>
</Window>
