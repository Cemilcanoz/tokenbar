<Window x:Class="tokenbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenBar"
        Width="286" Height="210"
        FontFamily="Segoe UI"
        Icon="tokenbar.ico"

        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual">

    <!--
      ⚠️ AllowsTransparency="True" YALNIZCA WindowStyle="None" ile çalışır.
      İkisi birlikte pencere çerçevesini tamamen kaldırıyor: başlık çubuğu,
      kapatma düğmesi, kenarlık — hiçbiri yok. Hepsini biz çiziyoruz,
      taşımayı biz yapıyoruz (MainWindow.xaml.cs → DragMove).

      Bedeli: donanım hızlandırması kapanıyor. 250x100'lük bir rozet için
      önemsiz; tam ekran bir uygulamada olsa düşünülürdü.
    -->

    <Window.Resources>

        <Style x:Key="Etiket" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A90A0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AltEtiket" TargetType="TextBlock" BasedOn="{StaticResource Etiket}">
            <Setter Property="Foreground" Value="#FF6B7382"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Sayi" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="AltSayi" TargetType="TextBlock" BasedOn="{StaticResource Sayi}">
            <Setter Property="Foreground" Value="#FF6B7382"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DuzButon" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB9F2E1"/>
            <Setter Property="Background" Value="#FF243940"/>
            <Setter Property="BorderBrush" Value="#557EE0C0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Kutu"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Kutu" Property="Background" Value="#FF35565B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Kutu" Property="BorderBrush" Value="#FFB9F2E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaglantiButon" TargetType="Button" BasedOn="{StaticResource DuzButon}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF7A8296"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="KotaCubugu" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#26FFFFFF" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="#FF7EE0C0"
                                           RadiusX="3" RadiusY="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Örtük stil: penceredeki tüm ScrollBar'lara uygulanır. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2EFFFFFF" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─────────── Ajan kartı (geniş hâl) ─────────── -->
        <DataTemplate x:Key="AjanKartiSablonu">
            <Border Background="#FF242B34" BorderBrush="#334B6570" BorderThickness="1"
                    CornerRadius="11" Padding="15,12" Margin="0,0,0,9">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Ad}"
                                   Foreground="#FFE8EAF0" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Toplam}"
                                   Foreground="#FF7EE0C0" FontSize="21" FontWeight="Light"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <Border Height="1" Background="#1AFFFFFF" Margin="0,11,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="yeni girdi" Style="{StaticResource Etiket}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding YeniGirdi}" Style="{StaticResource Sayi}"/>

                        <TextBlock Grid.Row="1" Text="önbellekten" Style="{StaticResource AltEtiket}" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Onbellek}" Style="{StaticResource AltSayi}" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OnbellekYuzde}"
                                   Style="{StaticResource AltSayi}" Margin="10,4,0,4" MinWidth="42"/>

                        <TextBlock Grid.Row="2" Text="çıktı" Style="{StaticResource Etiket}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Cikti}" Style="{StaticResource Sayi}"/>
                    </Grid>

                    <TextBlock Text="{Binding AltAjan}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AltEtiket}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AltAjan}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,13,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KotaVar}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding KotaBaslik}" Style="{StaticResource Etiket}" Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding KotaOran, Mode=OneWay}" Style="{StaticResource KotaCubugu}"/>
                        <TextBlock Text="{Binding KotaAlt}" Style="{StaticResource AltEtiket}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding UyariMetni}" Foreground="#FFE0B36A" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Uyari}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Istatistik}" Style="{StaticResource AltEtiket}"
                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!--
      Dış kabuk. Kenar boşluğu gölge için: AllowsTransparency sayesinde
      Margin'in dışı gerçekten saydam, gölge oraya düşüyor.
    -->
    <Border x:Name="Kabuk"
            Margin="12"
            CornerRadius="16"
            Background="#F21A222B"
            BorderBrush="#55788D91"
            BorderThickness="1"
            MouseLeftButtonDown="Kabuk_MouseLeftButtonDown"
            MouseMove="Kabuk_MouseMove"
            MouseLeftButtonUp="Kabuk_MouseLeftButtonUp">

        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>

            <!-- ══════════ KÜÇÜK HÂL — yüzen rozet ══════════ -->
            <Grid x:Name="KompaktPanel" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,7">
                    <TextBlock DockPanel.Dock="Right"
                               x:Name="KompaktDurumText"
                               Text=""
                               Foreground="#FF5C6474" FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="TOKENBAR"
                               Foreground="#FF6B7382" FontSize="10"
                               FontWeight="SemiBold"/>
                </DockPanel>

                <ItemsControl Grid.Row="1" x:Name="KompaktListesi">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Ad}"
                                               Foreground="#FF9BA2B2" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Toplam}"
                                               Foreground="#FF7EE0C0" FontSize="16"
                                               Margin="12,0,0,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>

                                <!--
                                  Kalan kota çubuğu. Yalnızca kota GERÇEKTEN
                                  geçerliyse çizilir; bayat veya yoksa
                                  yerine sebebi yazılır.
                                -->
                                <ProgressBar Value="{Binding KalanOran, Mode=OneWay}"
                                             Margin="0,5,0,3">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource KotaCubugu}">
                                            <Setter Property="Height" Value="4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KalanVar}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <TextBlock Text="{Binding KalanMetni}"
                                           FontSize="10.5"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF7EE0C0"/>
                                            <Style.Triggers>
                                                <!-- Kota yok / bayatsa sönük renk: sayı gibi durmasın. -->
                                                <DataTrigger Binding="{Binding KalanVar}" Value="False">
                                                    <Setter Property="Foreground" Value="#FF6B7382"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="2" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sürükle · konumlandır"
                               Foreground="#FF71818C" FontSize="10"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Detaylar  ›"
                            ToolTip="Detay panelini aç"
                            Style="{StaticResource DuzButon}"
                            Padding="10,5"
                            Click="DetaylarButton_Click"/>
                </Grid>
            </Grid>

            <!-- ══════════ GENİŞ HÂL — asıl panel ══════════ -->
            <Grid x:Name="GenisPanel" Margin="18,14,18,12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,13">
                    <Button DockPanel.Dock="Right"
                            x:Name="KucultButton"
                            Content="Küçült  ⌄"
                            ToolTip="Küçült  (Esc)"
                            Padding="10,7"
                            Margin="7,0,0,0"
                            Style="{StaticResource DuzButon}"
                            Click="KucultButton_Click"/>
                    <Button DockPanel.Dock="Right"
                            x:Name="YenileButton"
                            Content="↻  Yenile"
                            ToolTip="Verileri yeniden oku"
                            Style="{StaticResource DuzButon}"
                            Click="YenileButton_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TokenBar"
                                   Foreground="#FFE8EAF0" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AltBaslikText" Text="okunuyor…"
                                   Style="{StaticResource AltEtiket}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border x:Name="GenelToplamKutu"
                                Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="15,12" Margin="0,0,0,9"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="genel toplam" Style="{StaticResource Etiket}"/>
                                    <TextBlock Grid.Column="1" x:Name="GenelToplamText" Text="—"
                                               Style="{StaticResource Sayi}" FontSize="18"/>
                                </Grid>
                                <TextBlock Text="⚠️ Karşılaştırma amaçlı değildir — her ajanın tokenizer'ı ve fiyatı farklı."
                                           Style="{StaticResource AltEtiket}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="KartListesi" ItemTemplate="{StaticResource AjanKartiSablonu}"/>

                        <ItemsControl x:Name="PasifListesi" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ad}" Style="{StaticResource AltEtiket}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Sebep}" Style="{StaticResource AltEtiket}"
                                                   FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="OTURUMLAR · en çok harcayandan"
                                   Style="{StaticResource Etiket}" FontSize="11" Margin="2,15,0,8"/>

                        <Border Background="#1FFFFFFF" CornerRadius="10" Padding="4,6">
                            <ItemsControl x:Name="OturumListesi">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="11,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Ajan}" Foreground="#FF8A90A0" FontSize="10"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Etiket}"
                                                       Foreground="#FF9BA2B2" FontSize="12"
                                                       Margin="9,0,8,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Toplam}"
                                                       Foreground="#FFE8EAF0" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="2,11,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                x:Name="GenelToplamButton"
                                Content="genel toplamı göster"
                                Style="{StaticResource BaglantiButon}"
                                Click="GenelToplamButton_Click"/>
                        <TextBlock x:Name="DurumText" Text="" Style="{StaticResource Etiket}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="HataText" Text="" Foreground="#FFE86A6A" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
